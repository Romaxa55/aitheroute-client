#!/bin/sh
# Refuses a commit that carries a secret: gitleaks with .gitleaks.toml (its own
# rules plus this service's tokens) over what is staged. Without gitleaks there
# is no commit at all. Turn it on once per clone:
#
#   git config core.hooksPath .githooks
set -eu
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: install gitleaks first (https://github.com/gitleaks/gitleaks); nothing committed." >&2
  exit 1
fi
if ! gitleaks git --staged --redact --no-banner --config .gitleaks.toml; then
  echo "pre-commit: a secret is staged (redacted above); nothing committed." >&2
  exit 1
fi
